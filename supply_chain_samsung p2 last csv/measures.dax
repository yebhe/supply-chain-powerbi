-- ============================================================
-- MESURES DAX — Dashboard Supply Chain
-- A creer dans une table de mesures (Accueil > Nouvelle mesure)
-- ============================================================

-- ============ VENTES ============
CA Net = SUM(fact_sales[net_revenue])
CA Brut = SUM(fact_sales[gross_revenue])
Profit Total = SUM(fact_sales[profit])
Marge % = DIVIDE([Profit Total], [CA Net])
Qte Vendue = SUM(fact_sales[quantity_sold])
Remises Total = SUM(fact_sales[discount_amount])
Nb Commandes = DISTINCTCOUNT(fact_sales[order_number])
Panier Moyen = DIVIDE([CA Net], [Nb Commandes])

-- ============ PRODUCTION ============
Qte Produite = SUM(fact_production[quantity_produced])
Unites Defectueuses = SUM(fact_production[defective_units])
Taux Defaut % = DIVIDE([Unites Defectueuses], [Qte Produite])
Cout Production = 
    SUMX(
        fact_production,
        fact_production[quantity_produced] * RELATED(dim_product[unit_cost])
    )
Ratio Prod/Ventes = DIVIDE([Qte Produite], [Qte Vendue])

-- ============ STOCK ============
Stock Total = SUM(fact_inventory[stock_level])
Valeur Stock = 
    SUMX(
        fact_inventory,
        fact_inventory[stock_level] * RELATED(dim_product[unit_cost])
    )
Stock Sous Reorder = 
    CALCULATE(
        COUNTROWS(fact_inventory),
        FILTER(fact_inventory, fact_inventory[stock_level] < fact_inventory[reorder_point])
    )
Stock Critique = 
    CALCULATE(
        COUNTROWS(fact_inventory),
        FILTER(fact_inventory, fact_inventory[stock_level] < fact_inventory[safety_stock_level])
    )

-- ============ EXPEDITIONS ============
Nb Expeditions = COUNTROWS(fact_shipment)
Qte Expediee = SUM(fact_shipment[quantity])
Frais Port = SUM(fact_shipment[shipping_cost])
Poids Expedie = SUM(fact_shipment[total_weight_kg])
Nb Retards = 
    CALCULATE(COUNTROWS(fact_shipment), fact_shipment[status] = "Delayed")
Taux Retard % = DIVIDE([Nb Retards], [Nb Expeditions])
Taux Livraison % = 
    DIVIDE(
        CALCULATE(COUNTROWS(fact_shipment), fact_shipment[status] = "Delivered"),
        [Nb Expeditions]
    )

-- ============ ACHATS (PROCUREMENT) ============
Nb Commandes Achat = COUNTROWS(fact_procurement)
Cout Achats = SUM(fact_procurement[total_cost])
Lead Time Moyen = AVERAGE(fact_procurement[lead_time_days])
Quality Score Moyen = AVERAGE(fact_procurement[quality_score])

-- ============ KPIs TEMPORELS (YoY) ============
CA Net Y-1 = CALCULATE([CA Net], SAMEPERIODLASTYEAR(dim_date[date]))
CA Net YoY % = DIVIDE([CA Net] - [CA Net Y-1], [CA Net Y-1])

-- ============================================================
-- LES 6 KPI PRODUCTION + VARIATIONS vs N-1
-- Prerequis : dim_date marquee comme table de dates
-- ============================================================

-- KPI 1 : Quantite produite
Qte Produite N-1 = 
    CALCULATE([Qte Produite], SAMEPERIODLASTYEAR(dim_date[date]))
Qte Produite Var % = 
    DIVIDE([Qte Produite] - [Qte Produite N-1], [Qte Produite N-1])

-- KPI 2 : Ratio produit / vendu
Ratio Prod/Ventes N-1 = 
    CALCULATE([Ratio Prod/Ventes], SAMEPERIODLASTYEAR(dim_date[date]))
Ratio Prod/Ventes Var Pts = 
    [Ratio Prod/Ventes] - [Ratio Prod/Ventes N-1]

-- KPI 3 : Quantite defectueuse
Unites Defectueuses N-1 = 
    CALCULATE([Unites Defectueuses], SAMEPERIODLASTYEAR(dim_date[date]))
Unites Defectueuses Var % = 
    DIVIDE([Unites Defectueuses] - [Unites Defectueuses N-1], [Unites Defectueuses N-1])

-- KPI 4 : Taux de defaut
Taux Defaut N-1 = 
    CALCULATE([Taux Defaut %], SAMEPERIODLASTYEAR(dim_date[date]))
Taux Defaut Var Pts = 
    ([Taux Defaut %] - [Taux Defaut N-1]) * 100

-- KPI 5 : Nombre de lots
Nb Lots = DISTINCTCOUNT(fact_production[batch_number])
Nb Lots N-1 = 
    CALCULATE([Nb Lots], SAMEPERIODLASTYEAR(dim_date[date]))
Nb Lots Var % = 
    DIVIDE([Nb Lots] - [Nb Lots N-1], [Nb Lots N-1])

-- KPI 6 : Poids produit
Poids Produite = 
    SUMX(
        fact_production,
        fact_production[quantity_produced] * RELATED(dim_product[weight_kg])
    )
Poids Produite N-1 = 
    CALCULATE([Poids Produite], SAMEPERIODLASTYEAR(dim_date[date]))
Poids Produite Var % = 
    DIVIDE([Poids Produite] - [Poids Produite N-1], [Poids Produite N-1])

-- BONUS : Taux d'utilisation de capacite (annual_capacity dans dim_facility)
Capacite Annuelle = SUM(dim_facility[annual_capacity])
Taux Utilisation % = DIVIDE([Qte Produite], [Capacite Annuelle])

-- ============================================================
-- LES 6 KPI VENTES + VARIATIONS vs N-1
-- CA Net : deja couvert par CA Net Y-1 / CA Net YoY %
-- ============================================================

-- KPI 1 : CA Net (N-1 existe deja : CA Net Y-1, CA Net YoY %)

-- KPI 2 : Quantite vendue
Qte Vendue N-1 = 
    CALCULATE([Qte Vendue], SAMEPERIODLASTYEAR(dim_date[date]))
Qte Vendue Var % = 
    DIVIDE([Qte Vendue] - [Qte Vendue N-1], [Qte Vendue N-1])

-- KPI 3 : Nombre de commandes
Nb Commandes N-1 = 
    CALCULATE([Nb Commandes], SAMEPERIODLASTYEAR(dim_date[date]))
Nb Commandes Var % = 
    DIVIDE([Nb Commandes] - [Nb Commandes N-1], [Nb Commandes N-1])

-- KPI 4 : Marge % (variation en POINTS, pas en %)
Marge % N-1 = 
    CALCULATE([Marge %], SAMEPERIODLASTYEAR(dim_date[date]))
Marge % Var Pts = 
    ([Marge %] - [Marge % N-1]) * 100

-- KPI 5 : Profit
Profit Total N-1 = 
    CALCULATE([Profit Total], SAMEPERIODLASTYEAR(dim_date[date]))
Profit Total Var % = 
    DIVIDE([Profit Total] - [Profit Total N-1], [Profit Total N-1])

-- KPI 6 : Panier moyen
Panier Moyen N-1 = 
    CALCULATE([Panier Moyen], SAMEPERIODLASTYEAR(dim_date[date]))
Panier Moyen Var % = 
    DIVIDE([Panier Moyen] - [Panier Moyen N-1], [Panier Moyen N-1])
